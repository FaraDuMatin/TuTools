# Copy to .env and fill in. The real .env is gitignored.

# Postgres (consumed by docker-compose.yml)
POSTGRES_USER=tutoring
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tutoring
# Host port for the container. Defaults to 5433 to avoid clashing with a
# natively installed PostgreSQL, which usually owns 5432.
POSTGRES_PORT=5433

# Prisma / NestJS connection to the container above.
# 127.0.0.1, not localhost: on Windows localhost resolves to ::1 first and
# Docker only publishes on IPv4, which makes Prisma's engine hang.
DATABASE_URL="postgresql://tutoring:change-me@127.0.0.1:5433/tutoring?schema=public"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Ports: Next on 3000 (user-facing), Nest on 3001.
# WEB_ORIGIN is a comma-separated allowlist — Next falls back to another port
# when 3000 is occupied, and a single origin turns that into a CORS failure.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000,http://localhost:3002

# LiveKit. Generate a secret with: openssl rand -base64 32
# The secret signs join tokens and must never reach the browser.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880
# NOTE: the webhook URL is NOT set here. livekit-server does not expand env vars
# in its config, so it lives literally in infra/livekit.yaml.
