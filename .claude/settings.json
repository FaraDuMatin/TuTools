{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npm run test:cov)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run dev)",
      "Bash(npm run start:dev)",
      "Bash(npm ls*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate deploy*)",
      "Bash(npx prisma --version*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose up -d*)",
      "Bash(docker compose start*)",
      "Bash(docker compose restart*)",
      "Bash(docker compose config*)",
      "Bash(docker compose exec -T postgres pg_isready*)",
      "Bash(docker inspect *)",
      "Bash(docker ps*)",
      "Bash(docker info*)",
      "Bash(curl -s http://127.0.0.1:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -i http://127.0.0.1:*)",
      "Bash(curl -i http://localhost:*)",
      "Bash(node dist/main.js)",
      "Bash(node --version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git remote -v)",
      "PowerShell(Get-NetTCPConnection*)",
      "PowerShell(Get-Process*)",
      "PowerShell(Get-Service*)",
      "PowerShell(Test-Path*)"
    ],
    "deny": [
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push*)",
      "Bash(docker compose down*)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(node -e*)",
      "Bash(node --eval*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(Stop-Process*)",
      "PowerShell(Stop-Service*)",
      "PowerShell(Remove-Item*)"
    ]
  },
  "enabledMcpjsonServers": ["context7"]
}
